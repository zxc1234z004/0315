/**
 * 統合版後端（Firebase 升級版）
 * 【架構說明】
 * - 所有「寫入」操作（簽到紀錄、人員管理）已改由前端直接寫入 Firebase
 * - GAS 只負責「讀取」Google Sheets（地點設定、班級清單、名冊查詢、G欄資格驗證）
 * - syncFirebaseToSheets() 負責定時將 Firebase 紀錄同步回 Google Sheets
 *
 * 【試算表分頁配置要求】
 * 1. 「系統設定」：A:緯度, B:經度, C:距離(m), D:地點名稱, E:管理員密碼
 * 2. 「班級設定」：A:班級名稱 (若無此分頁，系統會自動掃描「名冊_」開頭的分頁)
 * 3. 「名冊_班名」：格式 A:memberId, B:性別, C:座號, D:姓名, E:單位/區域, G:狀態(0=未簽到,允許掃描)
 *
 * 【Firebase REST API 設定】
 * FIREBASE_PROJECT_ID：你的 Firebase 專案 ID
 * Firestore 規則需允許 GAS（服務帳號）讀取，或設定為公開讀取（測試用）
 */

// ⚙️ 請填入你的 Firebase 專案 ID（firebaseConfig 裡的 projectId）
const FIREBASE_PROJECT_ID = "roll-call-system-0411";

const SPREADSHEET_ID = SpreadsheetApp.getActiveSpreadsheet().getId();

function doGet(e) {
  const action = e.parameter.action;
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  // 1. 初始化讀取：回傳地點清單與班級清單
  if (!action || action === 'init') {
    const locSheet = ss.getSheetByName("系統設定");
    const classSheet = ss.getSheetByName("班級設定");
    const locations = [];
    let classes = [];

    // 讀取地點設定
    if (locSheet) {
      const locRows = locSheet.getDataRange().getValues();
      for (let i = 1; i < locRows.length; i++) {
        if (locRows[i][3]) { 
          locations.push({
            lat: locRows[i][0],
            lng: locRows[i][1],
            limit: locRows[i][2],
            name: locRows[i][3],
            password: String(locRows[i][4])
          });
        }
      }
    }

    // 讀取班級設定 (優先從班級設定分頁讀取，若無則掃描分頁名稱)
    if (classSheet) {
      const classRows = classSheet.getDataRange().getValues();
      for (let j = 1; j < classRows.length; j++) {
        if (classRows[j][0]) classes.push(classRows[j][0]);
      }
    }
    
    if (classes.length === 0) {
      const sheets = ss.getSheets();
      classes = sheets
        .map(s => s.getName())
        .filter(name => name.indexOf("名冊_") === 0)
        .map(name => name.replace("名冊_", ""));
    }

    return createJsonResponse("success", "資料載入成功", {
      locations: locations,
      classes: classes
    });
  }

  // 2. 取得特定班級名冊 (管理者手動點名用)
  if (action === 'getMemberList') {
    const className = e.parameter.className;
    const sheetName = "名冊_" + className;   // 讀取名冊 (與 init 前綴一致)
    const sheet = ss.getSheetByName(sheetName);
    
    if (!sheet) return createJsonResponse("error", "找不到工作表: " + sheetName);
    
    const data = sheet.getDataRange().getValues();
    if (data.length < 2) return createJsonResponse("success", "名冊無資料", []);
    
    // 跳過標題列，只回傳 G欄=0（允許點名）的成員
    const eligible = data.slice(1)
      .filter(row => row[3] !== "" && String(row[6]).trim() === "0")
      .map(row => ({
        memberId: String(row[0]),
        gender: row[1],
        seatNum: row[2],
        name: row[3],
        area: row[4]
      }));
    
    return createJsonResponse("success", "OK", eligible);
  }

  return createJsonResponse("error", "未知的指令 (Invalid Action)");
}

function doPost(e) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  try {
    const postData = JSON.parse(e.postData.contents);
    const action = postData.action;

    /**
     * 成員資格驗證（QR Code 掃碼使用）
     * 注意：寫入紀錄已改由前端直接寫入 Firebase，GAS 只負責驗證名冊資格
     */
    if (action === 'signin') {
      const targetId = String(postData.memberId).trim();
      const className = postData.className;
      const targetSheetName = "名冊_" + className;
      const memberSheet = ss.getSheetByName(targetSheetName);

      if (!memberSheet) return createJsonResponse("error", "找不到名冊分頁：" + targetSheetName);

      const memberData = memberSheet.getDataRange().getValues();
      let foundMember = null;

      for (let i = 1; i < memberData.length; i++) {
        if (String(memberData[i][0]).trim() === targetId) {
          const gValue = String(memberData[i][6]).trim(); // G 欄 (index 6)

          // 🚨 篩選條件：G 欄必須為 "0" 才允許簽到
          if (gValue !== "0") {
            return createJsonResponse("error", `⛔ 此成員目前無法簽到 (狀態: ${gValue || '非0'})，已略過。`);
          }

          foundMember = {
            gender: memberData[i][1],
            seatNum: memberData[i][2],
            name: memberData[i][3],
            area: memberData[i][4]
          };
          break;
        }
      }

      if (foundMember) {
        return createJsonResponse("success", "驗證通過", foundMember);
      } else {
        return createJsonResponse("error", "在「" + className + "」名冊中查無此 ID");
      }
    }

    /**
     * 備份紀錄至 Google Sheets（由前端 Firebase 寫入後，靜默呼叫此功能）
     * 不影響前端速度，背景執行即可
     */
    if (action === 'logToSheets') {
      const logHeaders = ["時間", "ID", "姓名", "性別", "座號", "區域", "地點", "驗證方式", "請假原因", "班名", "紀錄人"];
      const logSheet = getOrCreateSheet(ss, "簽到紀錄", logHeaders);
      logSheet.appendRow([
        new Date(),
        postData.memberId    || "",
        postData.name        || "",
        postData.gender      || "",
        postData.seatNum     || "",
        postData.area        || "",
        postData.locationName || "",
        postData.status      || "",
        postData.reason      || "",
        postData.className   || "",
        postData.staff       || ""
      ]);
      return createJsonResponse("success", "已備份至試算表");
    }

    return createJsonResponse("error", "未知的 Post 指令");
  } catch (err) {
    return createJsonResponse("error", "伺服器異常：" + err.toString());
  }
}

/**
 * ====================================================
 * 🔄 Firebase → Google Sheets 定時同步
 * 建議設定：每 5~10 分鐘觸發一次 syncFirebaseToSheets()
 * 設定方式：GAS 編輯器 → 觸發條件 → 新增觸發條件
 *           函式名稱: syncFirebaseToSheets
 *           基於時間 → 分鐘計時器 → 每 5 分鐘
 * ====================================================
 */
function syncFirebaseToSheets() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const logHeaders = ["時間", "ID", "姓名", "性別", "座號", "區域", "地點", "驗證方式", "請假原因", "班名", "紀錄人"];
  const logSheet = getOrCreateSheet(ss, "簽到紀錄", logHeaders);
  
  const props = PropertiesService.getScriptProperties();
  const lastSyncStr = props.getProperty('lastSyncTime');
  // 上次同步時間（ISO 字串），若沒有則從 24 小時前開始
  const lastSyncTime = lastSyncStr ? new Date(lastSyncStr) : new Date(Date.now() - 24 * 60 * 60 * 1000);

  // 讀取試算表已有的 Firebase Doc ID，避免重複寫入
  const existingIds = new Set();
  const lastRow = logSheet.getLastRow();
  // 「Firestore Doc ID」存在 L 欄（第12欄），標題為 "FirestoreDocId"
  if (lastRow >= 2) {
    const idCol = logSheet.getRange(2, 12, lastRow - 1, 1).getValues();
    idCol.forEach(r => { if (r[0]) existingIds.add(String(r[0])); });
  }
  // 補上 L 欄標題（若缺少）
  if (logSheet.getRange(1, 12).getValue() !== "FirestoreDocId") {
    logSheet.getRange(1, 12).setValue("FirestoreDocId");
  }

  // 呼叫 Firestore REST API 取得簽到紀錄
  // 使用 structuredQuery 篩選出 lastSyncTime 之後的紀錄
  const apiUrl = `https://firestore.googleapis.com/v1/projects/${FIREBASE_PROJECT_ID}/databases/(default)/documents:runQuery`;
  const token = ScriptApp.getOAuthToken();

  const queryBody = {
    structuredQuery: {
      from: [{ collectionId: "signin_records" }],
      orderBy: [{ field: { fieldPath: "time" }, direction: "ASCENDING" }],
      // 只撈 lastSyncTime 之後的資料（避免資料量過大）
      where: {
        fieldFilter: {
          field: { fieldPath: "time" },
          op: "GREATER_THAN",
          value: { timestampValue: lastSyncTime.toISOString() }
        }
      },
      limit: 500  // 每次最多同步 500 筆
    }
  };

  try {
    const response = UrlFetchApp.fetch(apiUrl, {
      method: 'POST',
      contentType: 'application/json',
      headers: { Authorization: 'Bearer ' + token },
      payload: JSON.stringify(queryBody),
      muteHttpExceptions: true
    });

    const results = JSON.parse(response.getContentText());
    if (!Array.isArray(results)) {
      console.error('[syncFirebaseToSheets] 非預期回應:', response.getContentText());
      return;
    }

    const rows = [];
    let newLastSyncTime = lastSyncTime;

    results.forEach(item => {
      if (!item.document) return; // 空回應跳過
      const docName = item.document.name; // projects/.../documents/signin_records/DOC_ID
      const docId = docName.split('/').pop();
      if (existingIds.has(docId)) return; // 已同步，跳過

      const fields = item.document.fields || {};
      const getStr = (f) => (fields[f] && (fields[f].stringValue !== undefined ? fields[f].stringValue : String(fields[f].integerValue || ''))) || '';
      const getTs  = (f) => fields[f] && fields[f].timestampValue ? new Date(fields[f].timestampValue) : '';

      const recordTime = getTs('time');
      if (recordTime && recordTime > newLastSyncTime) newLastSyncTime = recordTime;

      rows.push([
        recordTime || new Date(),
        getStr('memberId'),
        getStr('name'),
        getStr('gender'),
        getStr('seatNum'),
        getStr('area'),
        getStr('locationName'),
        getStr('status'),
        getStr('reason'),
        getStr('className'),
        getStr('staff'),
        docId  // L 欄存 Firestore Doc ID，防重複
      ]);
    });

    if (rows.length > 0) {
      logSheet.getRange(logSheet.getLastRow() + 1, 1, rows.length, 12).setValues(rows);
      console.log(`[syncFirebaseToSheets] 同步完成，新增 ${rows.length} 筆紀錄`);
    } else {
      console.log('[syncFirebaseToSheets] 沒有新紀錄需要同步');
    }

    // 更新最後同步時間
    props.setProperty('lastSyncTime', newLastSyncTime.toISOString());

  } catch (err) {
    console.error('[syncFirebaseToSheets] 執行失敗:', err.toString());
  }
}

/**
 * 一次性：將 Firebase 所有歷史紀錄全部同步到 Sheets（初始化用）
 * 使用方式：手動在 GAS 編輯器執行此函式一次即可
 */
function syncAllHistoryFromFirebase() {
  // 清除上次同步記錄，讓 syncFirebaseToSheets 從頭讀取
  PropertiesService.getScriptProperties().deleteProperty('lastSyncTime');
  // 重設起始時間為很久以前（撈全部資料）
  PropertiesService.getScriptProperties().setProperty('lastSyncTime', new Date('2020-01-01').toISOString());
  syncFirebaseToSheets();
}

/**
 * 輔助函式：確保工作表存在，若不存在則建立並寫入標題
 */
function getOrCreateSheet(ss, name, headers) {
  let sheet = ss.getSheetByName(name);
  if (!sheet) {
    sheet = ss.insertSheet(name);
    sheet.appendRow(headers);
  } else {
    const lastCol = sheet.getLastColumn();
    if (lastCol < headers.length) {
      sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    }
  }
  return sheet;
}

/**
 * 輔助函式：標準化回傳 JSON 格式
 */
function createJsonResponse(status, message, data = null) {
  const output = { status: status, message: message, data: data };
  return ContentService.createTextOutput(JSON.stringify(output))
    .setMimeType(ContentService.MimeType.JSON);
}
